# BiteFinder Database Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control!

DB_HOST=bitefinderapp.database.windows.net
DB_NAME=free-sql-db-6399592
DB_USER=your_database_user
DB_PASS=your_database_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_min_32chars
JWT_EXPIRY=3600

# Environment (development, staging, production)
APP_ENV=development

# API Server
API_PORT=8000
API_HOST=127.0.0.1

# CORS Configuration
# CORS_ALLOWED_ORIGIN=https://bitefinder.example.com

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/bitefinder.log

# External APIs
NIF_API_KEY=your_nif_pt_api_key_here

# Social Logins (Client IDs / Secrets)
GOOGLE_CLIENT_ID=your_google_client_id_here
FACEBOOK_CLIENT_ID=your_facebook_client_id_here
APPLE_CLIENT_ID=your_apple_client_id_here
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
